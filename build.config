# Build configuration - single source of truth for build scripts
# Update BUILD_BRANCH here when switching deployment branches
BUILD_BRANCH=port/arxena-modules

# AWS CLI profile for builder EC2 / EBS / S3 (override with AWS_PROFILE=).
# SSH still uses ~/.ssh/arxmukti-key.pem and EC2 key pair arxmukti-key.
# AWS_PROFILE=arxmukti-key
# BUILDER_VOLUME_TAG_NAME=arxena-builder-workspace
# BUILDER_NX_CACHE_S3=s3://arxmukti-builder-nx-cache/linux-arm64
# FORCE_FULL_BUILD=0
# SKIP_EBS=0
