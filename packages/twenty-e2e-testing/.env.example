# Note that provide always without trailing forward slash to have expected behaviour
FRONTEND_BASE_URL=http://localhost:3001
BACKEND_BASE_URL=http://localhost:3000
# Workspace subdomain used by refresh-dev-auth.mjs (must match a real workspace slug in the DB)
WORKSPACE_ORIGIN=http://<workspace-slug>.localhost:3001
DEFAULT_LOGIN=tim@apple.dev
DEFAULT_PASSWORD=Applecar2025
WEBSITE_URL=https://twenty.com
WEBSITE_BASE_URL=http://localhost:3002

# E2E_TEST_COMPANY=salesforce  # Company to search in org chart tests (default: salesforce)
# For sitemap rollout tests: RUN_SITEMAP_TESTS=1, SITEMAP_EXPOSED_BATCH_COUNT=1|5|51
# For orgchart pipeline (Python query generator): ARXENA_SITE_URL=http://localhost:5050

# Build all arx-crx variants before E2E (from packages/twenty-e2e-testing): yarn build:arx-crx-matrix
# (Runs npm run build:* inside ../../../arx-crx — sibling repo; npm avoids Yarn workspace lockfile errors.)
# Or: yarn nx run twenty-e2e-testing:build:arx-crx-e2e-matrix
# Full E2E after builds: yarn test:arx-crx-extension:with-builds  —  nx: twenty-e2e-testing:test:arx-crx-extension:with-builds
#
# Chrome extension E2E (Playwright loads unpacked from ../arx-crx/dist or ../arx-crx/dist-store)
# Build arx-crx first (same repo sibling as arxena). Dev/prod share one folder per manifest: internal → dist/, store → dist-store/.
# E2E_ARX_ENV=dev|prod — expected API base for smoke assertion: dev → http://localhost:5050, prod → https://arxena.com
# E2E_ARX_CRX=internal|store — which unpacked folder (alias: ARX_CRX_BUILD=store)
E2E_ARX_ENV=dev
E2E_ARX_CRX=internal
# Optional: exact manifest folder if not next to arxena (overrides E2E_ARX_CRX path)
# ARX_CRX_DIST=
# Overrides: E2E_EXPECT_ARX_BASE_URL, E2E_APP_URL (see tests/arx-crx/arxCrxExtensionHelpers.ts)
#
# Store manifest may not inject on *.localhost (see shouldExpectContentScriptOnApp). Dev + store still uses FRONTEND_BASE_URL for app origin; use prod + store (or E2E_APP_URL) for app.arxena.com.
#
# Extension browser: E2E_CRX_HEADLESS=1 headless, =0 headed. Unset: headed locally; headless when CI is set.
# E2E_CRX_HEADLESS=0
# Extension E2E: playwright-extra + stealth (LinkedIn). Set E2E_CRX_STEALTH=0 to use vanilla Chromium.
# E2E_CRX_STEALTH=0
#
# Optional: assert Unipile shows Connected after onboarding + LinkedIn cookie (needs working backend + Unipile for the workspace)
# E2E_ASSERT_UNIPILE_CONNECTED=1
# Optional: full flows — extension job upload from LinkedIn / InMail (staging only)
# E2E_EXTENSION_JOB_UPLOAD=1
# E2E_EXTENSION_INMAIL=1
# Optional: LinkedIn profile URL for @staging load/scrape checks (public or li_at session)
# E2E_LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/williamhgates/

# Optional: LinkedIn session cookie — used by scripts/check-linkedin-li-at.mjs and, when set,
# tests/arx-crx-extension.spec.ts (LinkedIn feed session + Unipile pill lifecycle on the popup).
# LINKEDIN_LI_AT=
# Optional: assert feed page shows this name (space-separated parts), e.g. "First Last"
# LINKEDIN_EXPECTED_SESSION_NAME=

# === DO NOT USE, WORK IN PROGRESS ===
# This URL must have trailing forward slash as all REST API endpoints have object after it
# Documentation for REST API: https://twenty.com/developers/rest-api/core#/
# REST_API_BASE_URL=http://localhost:3000/rest/

# Documentation for GraphQL API: https://twenty.com/developers/graphql/core
# GRAPHQL_BASE_URL=http://localhost:3000/graphql

# Without this key, all API tests will fail, to generate this key
# Log in to Twenty workspace, go to Settings > Developers, generate new key and paste it here
# In order to use it, header Authorization: Bearer token must be used
# This key works for both REST and GraphQL API
# API_DEV_KEY=fill_with_proper_key

# === tests/integration (yarn test:integration:rest) ===
# E2E_API_TOKEN=  # same as API key; Authorization Bearer
# E2E_INTEGRATION_MATRIX=1  # run full org-chart matrix
# Full matrix is strict by default: 201+queued must await Redis terminal — set E2E_ORGCHART_ASSERT_COMPLETION=1 and E2E_REDIS_URL (same Redis as twenty-server), or set E2E_ORGCHART_MATRIX_RELAXED=1 to only assert HTTP acceptance.
#
# E2E_INTEGRATION_PIPELINE_MATRIX=1  # tests/integration/pipeline.rest.integration.e2e.spec.ts — Litify TheOrg enriched + 18 Unipile + 12 Apify + 12 LinkedIn x-ray + Apify 400 negatives + extra Unipile modes + title-taxonomy search-keywords (arxena-site) + message/stream
# E2E_PIPELINE_COMPANY_NAME=  E2E_PIPELINE_COMPANY_ID=  E2E_PIPELINE_LINKEDIN_COMPANY_URL=  # optional overrides (default covvalent)
# E2E_CANDIDATE_CHAT_ASSISTANT_THREAD_ID=  # required for message/stream CTO tests inside pipeline spec