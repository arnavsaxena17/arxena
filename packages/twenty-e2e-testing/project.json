{
  "name": "twenty-e2e-testing",
  "projectType": "application",
  "tags": [
    "scope:testing"
  ],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright install",
          "cp .env.example .env"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test"
        ]
      }
    },
    "test:jobs-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/jobs.pipeline.spec.ts --project=chrome --no-deps"
        ]
      }
    },
    "test:website-orgchart-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/website.orgchart.pipeline.spec.ts --project=website-orgchart"
        ]
      }
    },
    "test:orgchart-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/orgchart.pipeline.spec.ts --project=orgchart-pipeline"
        ]
      }
    },
    "test:sitemap-rollout": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/sitemap.companies.rollout.spec.ts --project=website"
        ]
      }
    },
    "test:sitemap-rollout:all-counts": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "for c in 1 5 51; do SITEMAP_EXPOSED_BATCH_COUNT=$c RUN_SITEMAP_TESTS=1 yarn playwright test tests/sitemap.companies.rollout.spec.ts --project=website; done"
        ]
      }
    },
    "test:signup-delete-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/signup.delete-account.pipeline.spec.ts --project=chrome --no-deps"
        ]
      }
    },
    "test:assistant-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/assistant.upload-jd-create-job.spec.ts --project=chrome --no-deps"
        ]
      }
    },
    "test:assistant-add-job-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/assistant.add-new-job.pipeline.spec.ts --project=chrome --no-deps"
        ]
      }
    },
    "test:arx-crx-extension": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/arx-crx-extension.spec.ts --project=chrome --no-deps"
        ]
      }
    },
    "test:ui": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test --ui"
        ]
      }
    },
    "test:debug": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test --debug"
        ]
      }
    },
    "test:report": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright show-report"
        ]
      }
    }
  }
}
