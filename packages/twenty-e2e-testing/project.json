{
  "name": "twenty-e2e-testing",
  "projectType": "application",
  "tags": [
    "scope:testing"
  ],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright install",
          "cp .env.example .env"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test"
        ]
      }
    },
    "test:jobs-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/jobs.pipeline.spec.ts --project=chrome --no-deps"
        ]
      }
    },
    "test:website-orgchart-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/website.orgchart.pipeline.spec.ts --project=website-orgchart"
        ]
      }
    },
    "test:orgchart-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/orgchart.pipeline.spec.ts --project=orgchart-pipeline"
        ]
      }
    },
    "test:sitemap-rollout": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/sitemap.companies.rollout.spec.ts --project=website"
        ]
      }
    },
    "test:sitemap-rollout:all-counts": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "for c in 1 5 51; do SITEMAP_EXPOSED_BATCH_COUNT=$c RUN_SITEMAP_TESTS=1 yarn playwright test tests/sitemap.companies.rollout.spec.ts --project=website; done"
        ]
      }
    },
    "test:signup-delete-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/signup.delete-account.pipeline.spec.ts --project=chrome --no-deps"
        ]
      }
    },
    "test:assistant-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/assistant.upload-jd-create-job.spec.ts --project=chrome --no-deps"
        ]
      }
    },
    "test:assistant-add-job-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/assistant.add-new-job.pipeline.spec.ts --project=chrome --no-deps"
        ]
      }
    },
    "build:arx-crx-e2e-matrix": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "cd ../../../arx-crx && npm run build:dev:internal && npm run build:prod:internal && npm run build:dev:store && npm run build:prod:store"
        ]
      }
    },
    "test:arx-crx-extension:with-builds": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "cd ../../../arx-crx && npm run build:dev:internal && npm run build:prod:internal && npm run build:dev:store && npm run build:prod:store",
          "yarn playwright test tests/arx-crx-extension.spec.ts --project=chrome --no-deps"
        ]
      }
    },
    "test:arx-crx-extension": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/arx-crx-extension.spec.ts --project=chrome --no-deps"
        ]
      }
    },
    "test:arx-crx-extension:smoke": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/arx-crx-extension.spec.ts --project=chrome --no-deps --grep @smoke"
        ]
      }
    },
    "test:arx-crx-extension:internal-local": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "sh -c 'E2E_ARX_ENV=\"${E2E_ARX_ENV:-dev}\" E2E_ARX_CRX=\"${E2E_ARX_CRX:-internal}\" FRONTEND_BASE_URL=\"${FRONTEND_BASE_URL:-http://localhost:3001}\" yarn playwright test tests/arx-crx-extension.spec.ts --project=chrome --no-deps'"
        ]
      }
    },
    "test:arx-crx-extension:store-prod": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "sh -c 'E2E_ARX_ENV=\"${E2E_ARX_ENV:-prod}\" E2E_ARX_CRX=\"${E2E_ARX_CRX:-store}\" yarn playwright test tests/arx-crx-extension.spec.ts --project=chrome --no-deps'"
        ]
      }
    },
    "test:ui": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test --ui"
        ]
      }
    },
    "test:debug": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test --debug"
        ]
      }
    },
    "test:report": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright show-report"
        ]
      }
    },
    "check-linkedin-li-at": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "node scripts/check-linkedin-li-at.mjs"
        ]
      }
    },
    "test:integration-rest": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test tests/integration --project=integration-api"
        ]
      }
    },
    "test:integration-rest-matrix": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "sh -c 'E2E_INTEGRATION_MATRIX=${E2E_INTEGRATION_MATRIX:-1} yarn playwright test tests/integration --project=integration-api'"
        ]
      }
    },
    "test:integration-pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "sh -c 'E2E_INTEGRATION_PIPELINE_MATRIX=${E2E_INTEGRATION_PIPELINE_MATRIX:-1} yarn playwright test tests/integration/pipeline.rest.integration.e2e.spec.ts --project=integration-api'"
        ]
      }
    }
  }
}
