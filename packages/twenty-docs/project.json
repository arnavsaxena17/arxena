{
  "name": "twenty-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/twenty-docs",
  "projectType": "application",
  "tags": ["scope:docs"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "rm -rf .mintlify/exports && NODE_OPTIONS='--max-old-space-size=8192' mintlify dev --port 3003"
      }
    },
    "export-people-openapi": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/openapi/people-api.json"],
      "options": {
        "command": "tsx packages/twenty-docs/scripts/export-people-openapi.ts"
      }
    },
    "export-company-openapi": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/openapi/company-api.json"],
      "options": {
        "command": "tsx packages/twenty-docs/scripts/export-company-openapi.ts"
      }
    },
    "export-jobs-openapi": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/openapi/jobs-api.json"],
      "options": {
        "command": "tsx packages/twenty-docs/scripts/export-jobs-openapi.ts"
      }
    },
    "export-posts-openapi": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/openapi/posts-api.json"],
      "options": {
        "command": "tsx packages/twenty-docs/scripts/export-posts-openapi.ts"
      }
    },
    "check-openapi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx packages/twenty-docs/scripts/check-openapi-exports.ts"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx tsx scripts/check-openapi-exports.ts && npx tsx scripts/generate-docs-json.ts && mintlify validate"
      }
    },
    "export": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.mintlify/export.zip"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx tsx scripts/generate-docs-json.ts && mintlify export --output .mintlify/export.zip"
      }
    },
    "lint": {},
    "fmt": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "prettier . --check --cache --cache-location ../../.cache/prettier/{projectRoot} --cache-strategy metadata"
      },
      "configurations": {
        "ci": {},
        "fix": {
          "command": "prettier . --write --cache --cache-location ../../.cache/prettier/{projectRoot} --cache-strategy metadata"
        }
      }
    }
  }
}
