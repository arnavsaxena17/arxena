{
  "name": "twenty-docs",
  "description": "Arxena documentation site powered by Mintlify",
  "author": "",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "mintlify dev",
    "validate": "npx tsx scripts/generate-docs-json.ts && mintlify validate",
    "export": "npx tsx scripts/generate-docs-json.ts && mintlify export --output .mintlify/export.zip",
    "export:brands": "node scripts/export-static-sites.mjs",
    "fix-links": "bash scripts/fix-translated-links.sh",
    "lint": "npx oxlint -c .oxlintrc.json ."
  },
  "dependencies": {
    "mintlify": "^4.2.594"
  },
  "devDependencies": {
    "twenty-shared": "workspace:*"
  },
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": "^4.0.2"
  }
}
