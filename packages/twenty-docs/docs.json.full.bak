{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Arxena Documentation",
  "theme": "almond",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo-dark.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#141414",
    "light": "#fafafa",
    "dark": "#141414"
  },
  "interaction": {
    "drilldown": false
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Try Arxena",
      "href": "https://app.arxena.com/welcome"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.arxena.com"
    }
  },
  "api": {
    "openapi": [
      "openapi/people-api.json"
    ],
    "url": "full",
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": [
        "curl",
        "node",
        "ruby",
        "php",
        "python",
        "javascript",
        "typescript",
        "go",
        "java",
        "csharp",
        "c",
        "c++",
        "kotlin",
        "swift",
        "rust",
        "powershell",
        "dart",
        "dotnet"
      ],
      "defaults": "required",
      "prefill": true
    }
  },
