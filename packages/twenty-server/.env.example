# Arxena integrations
# ARXENA_SITE_URL=http://localhost:5050
# ARXENA_SITE_ORGCHART_URL=http://localhost:5050
# WHATSAPP_OUTBOUND_MESSAGES_PER_MINUTE=5  # Max outbound WhatsApp messages per minute per Unipile account (job field can override)
# WHATSAPP_OUTBOUND_JITTER_MIN_MS=2000  # Random pre-send delay lower bound (ms)
# WHATSAPP_OUTBOUND_JITTER_MAX_MS=8000  # Random pre-send delay upper bound (ms)

# Unipile (LinkedIn search) - for testing use UNIPILE_LINKEDIN_ACCOUNT_ID + UNIPILE_ACCESS_TOKEN
# UNIPILE_API_URL=https://api.unipile.com
# UNIPILE_ACCESS_TOKEN=  # Unipile API key
# UNIPILE_LINKEDIN_ACCOUNT_ID=  # Optional fallback when workspace member profile has no LinkedIn Unipile account id
# LINKEDIN_UNIPILE_ESTIMATE_ACCOUNT_MODE=session  # session | shared_sales_navigator_pool (1) | env_account_id (3) — org-chart / super-impose estimates only
# LINKEDIN_UNIPILE_OUTREACH_ACCOUNT_MODE=shared_sales_navigator_pool  # session | shared_sales_navigator_pool (1) | env_account_id (3) — org-chart outreach generate-message (default: shared pool, no on-demand cookie reconnect)
# LINKEDIN_UNIPILE_SESSION_IDLE_TTL_MS=300000  # idle disconnect delay for on-demand sessions (rolling window, default 5 min)
# Elasticsearch (org charts, people, companies indices on ES EC2)
# arxmukti (arxena-es-t4g): ec2-44-210-207-156.compute-1.amazonaws.com
# ES_ENDPOINT=http://elastic:password@ec2-44-210-207-156.compute-1.amazonaws.com:9200
# ORGCHARTS_ES_INDEX=org-charts-all
# PEOPLE_ES_INDEX=people_all
# COMPANIES_ES_INDEX=companies_index_text
# COMPANIES_SCORES_ES_INDEX=std_company_data_scores
# PDL_API_KEY=replace_me_with_people_data_labs_api_key
# ORG_CHART_PDL_PROXY_SECRET=generate_a_long_random_secret  # same value on twenty-website; PDL proxy + POST /website/free-trial-lead, /website/calendly-booking-completed, and /website/privacy-consent from website
# FREE_TRIAL_LEAD_WORKSPACE_ID=<workspace-uuid>  # workspace where free trial leads create CRM records
# FREE_TRIAL_WORKFLOW_CONNECTED_ACCOUNT_ID=<gmail-connected-account-uuid>  # send-email steps in free trial workflow
# ORG_CHART_GUARD_MODE=log_only  # log_only (default) or enforce — blocks non-browser public org-chart GET without auth
# ORG_CHART_ALLOW_VERIFIED_BOTS=1  # DNS-verified Google/Bing bots (set 0 to disable)
# ORG_CHART_OPENAI_BOT_CIDRS=  # optional comma-separated IPv4 CIDRs for OpenAI crawlers
# CORESIGNAL_API_KEY=replace_me_with_coresignal_api_key
# CORESIGNAL_EMPLOYEE_API=multi_source  # or employee_base (search/preview/collect paths)
# NUBELA_API_KEY=replace_me_with_nubela_api_key_for_company_logos
# APIFY_API_TOKEN=replace_me_with_apify_api_token_for_employee_count
# RapidAPI fallback for Apollo org search (`/search_organization`) when Apollo returns rate-limit/errors.
# RAPIDAPI_APOLLO_ORG_SEARCH_HOST=apollo-io-no-cookies-required.p.rapidapi.com
# RAPIDAPI_APOLLO_ORG_SEARCH_KEY=replace_me_with_rapidapi_key
# Bright Data SERP (optional) — Google `site:theorg.com` fallback when TheOrg slug candidates fail and the slug is not in THEORG_SLUG_STATIC_OVERRIDES
# BRIGHT_DATA_API_KEY=
# BRIGHT_DATA_SERP_ZONE=serp_api
# BRIGHT_DATA_REQUEST_TIMEOUT_MS=90000
# Mixpanel project secret (Query / Export API, pipelines). Never expose in the browser or commit a real value.
# MIXPANEL_API_SECRET=
# IPinfo token for server-side country lookup (pricing geo, LinkedIn session country fallback)
# IPINFO_TOKEN=
# Optional client-side token (domain-whitelist in ipinfo dashboard): REACT_APP_IPINFO_TOKEN / NEXT_PUBLIC_IPINFO_TOKEN
