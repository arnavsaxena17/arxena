{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "outDir": "../../.cache/tsc",
    "types": ["node", "vite/client"]
  },
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "**/*.spec.tsx", "**/*.test.tsx"],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
