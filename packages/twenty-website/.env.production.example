# Org chart scraper protection (production twenty-website)
# Space-separated IPv4 CIDRs → SSR-only org-chart HTML (no OrgChartPageClient)
ORG_CHART_SCRAPER_CIDRS=43.173.0.0/16 43.172.0.0/16
ORG_CHART_GUARD_MODE=log_only
ORG_CHART_ALLOW_VERIFIED_BOTS=1
ORG_CHART_PAGE_RATE_LIMIT_MAX=30
ORG_CHART_API_RATE_LIMIT_MAX=30
# autocomplete + employee-count only (company-logo is not rate limited)
ORG_CHART_API_RATE_LIMIT_EXPENSIVE_MAX=5
ORG_CHART_API_RATE_LIMIT_SITEMAP_MAX=600
# After 48h of log_only monitoring with no false positives:
# ORG_CHART_GUARD_MODE=enforce

# Free trial lead form + inline Calendly (default on; set to false for direct app sign-up)
# NEXT_PUBLIC_FREE_TRIAL_LEAD_FLOW=false

# Calendly embed URL (optional; defaults to https://calendly.com/arxena/30min)
# NEXT_PUBLIC_CALENDLY_URL=

# Free trial leads use existing ORG_CHART_PDL_PROXY_SECRET + SERVER_BASE_URL (same as org-chart API proxy).
