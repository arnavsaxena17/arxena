{
  "name": "twenty-website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "scope:frontend"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/.next"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx next build"
      }
    }
  }
}