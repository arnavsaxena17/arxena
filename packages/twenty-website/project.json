{
  "name": "twenty-website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/twenty-website/src",
  "projectType": "application",
  "tags": [
    "scope:website",
    "scope:frontend"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "twenty-orgchart"
          ],
          "target": "build"
        },
        {
          "projects": [
            "twenty-shared"
          ],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx next dev --port 3002"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/.next"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx next build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx tsc -p tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx next lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx jest --passWithNoTests --testPathPattern=packages/twenty-website || true"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx next start --port 3002"
      }
    }
  }
}
