GITHUB_TOKEN=your_github_token
DATABASE_PG_URL=postgres://website:website@localhost:5432/website # only if using postgres
NEXT_PUBLIC_ALGOLIA_APP_ID=twenty_appId
NEXT_PUBLIC_ALGOLIA_API_KEY=twenty_apiKey

# Org chart API - backend server URL (twenty-server) for org chart data, autocomplete, company logos.
# In development, NestJS runs on 3000.
SERVER_BASE_URL=http://localhost:3000

# App URL - used when fetching org chart via API route (same-origin proxy).
# In development, Next.js typically runs on 3002.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Frontend URL - React app (twenty-front) for sign-up/sign-in links.
# In development, React runs on 3001. Should match twenty-server FRONTEND_URL.
# NEXT_PUBLIC_ prefix required for client components (e.g. header CallToAction).
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001
