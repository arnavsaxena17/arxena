{
  "name": "twenty-website",
  "version": "0.42.0-canary",
  "private": true,
  "scripts": {
    "nx": "NX_DEFAULT_PROJECT=twenty-website node ../../node_modules/nx/bin/nx.js",
    "dev": "npx nx build twenty-orgchart && npx next dev --port 3002",
    "generate-sitemaps": "npx tsx scripts/generate-sitemaps.ts",
    "build": "yarn generate-sitemaps && npx nx build twenty-orgchart && npx next build",
    "build:ci": "npx nx build twenty-orgchart && npx next build --no-lint",
    "start": "npx next start --port 3002",
    "lint": "npx next lint"
  },
  "dependencies": {
    "@docsearch/react": "^3.6.2",
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@nivo/calendar": "^0.87.0",
    "@tabler/icons-react": "^2.44.0",
    "facepaint": "^1.2.1",
    "framer-motion": "^11.18.0",
    "gray-matter": "^4.0.3",
    "hex-rgb": "^5.0.0",
    "libphonenumber-js": "^1.10.26",
    "mixpanel-browser": "^2.75.0",
    "next": "14.2.5",
    "next-runtime-env": "^3.2.2",
    "postgres": "^3.4.3",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-phone-number-input": "^3.3.4",
    "twenty-orgchart": "workspace:*",
    "twenty-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/facepaint": "^1.2.5",
    "@types/node": "^20",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  }
}
