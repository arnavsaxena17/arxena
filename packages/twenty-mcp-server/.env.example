# Arxena MCP Server Configuration

# --- stdio mode (Claude Desktop local) ---
# Required: Bearer JWT for authenticating with twenty-server
ARXENA_API_TOKEN=your-workspace-api-key-jwt

# Optional: Base URL for the Arxena twenty-server
ARXENA_BASE_URL=http://localhost:3000

# Optional: Workspace member ID (e.g. recruiterId on create_job)
# ARXENA_WORKSPACE_MEMBER_ID=

# --- HTTP mode (remote MCP at mcp.arxena.com) ---
# MCP_HTTP_PORT=3005
# MCP_HTTP_PATH=/mcp
# MCP_PUBLIC_URL=https://mcp.arxena.com/mcp
# MCP_OAUTH_ISSUER_URL=https://mcp.arxena.com
# MCP_PUBLIC_TOOLS_ONLY=true
# MCP_OAUTH_ENABLED=true
# MCP_PRIVACY_POLICY_URL=https://arxena.com/legal/privacy/mcp
# MCP_DOCUMENTATION_URL=https://mcp.arxena.com/docs/mcp
