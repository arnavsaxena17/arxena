{
  "name": "twenty-mcp-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/twenty-mcp-server/src",
  "projectType": "application",
  "tags": ["scope:mcp"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-mcp-server",
        "command": "yarn build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "start:http": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "packages/twenty-mcp-server",
        "command": "yarn start:http"
      }
    }
  }
}
