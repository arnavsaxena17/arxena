REACT_APP_SERVER_BASE_URL=http://localhost:3000
# Marketing site base for share links (/org-chart/share, /org/{slug}). Local default: same host as the app, port 3002.
# REACT_APP_ARXENA_SITE_BASE_URL=http://localhost:3002
# REACT_APP_ARXENA_SITE_PORT=3002
GENERATE_SOURCEMAP=true
TRANSLATION_IO_API_KEY=xxx


# ———————— Optional ————————
# Mixpanel: production uses REACT_APP_MIXPANEL_TOKEN; `yarn start` uses the dev project unless overridden.
# REACT_APP_MIXPANEL_TOKEN=
# REACT_APP_MIXPANEL_DEV_TOKEN=
# REACT_APP_MIXPANEL_ALLOW_IN_DEVELOPMENT=true
# REACT_APP_ANALYTICS_DEPLOYMENT=staging
# Post sign-in / onboarding landing: `jobs` (default) or `org-chart`
# REACT_APP_POST_AUTH_LANDING=org-chart
# REACT_APP_PORT=3001
# CHROMATIC_PROJECT_TOKEN=
# VITE_DISABLE_TYPESCRIPT_CHECKER=true
# VITE_DISABLE_ESLINT_CHECKER=true
# VITE_ENABLE_SSL=false
# VITE_HOST=localhost.com
# SSL_KEY_PATH="./certs/your-cert.key"
# SSL_CERT_PATH="./certs/your-cert.crt"