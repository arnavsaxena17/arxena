              "path": ["org-chart-outreach", "icp", "extract"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"personIdentifier\": \"gaurav-sherlocks-ai\",\n  \"companyIdentifier\": \"sherlocks-ai\",\n  \"includePosts\": false\n}"
