{
  "info": {
    "name": "Arxena",
    "description": "Arxena API collection. Set `baseUrl` and `authToken` in collection variables (or an environment) before running.\n\nRun order matters for the Org Chart Outreach folder: `ICP Extract - Provided Profiles` stores the extracted ICP in collection variables, which the ICP Candidates requests then reuse. Defaults are provided so candidates requests can also run standalone.\n\nCLI: npx newman run postman/org-chart-outreach/arxena.postman_collection.json --env-var authToken=<jwt>",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "extractedIcp",
      "value": "{\"industry\":[\"B2B SaaS\"],\"employee_range\":\"200-2000\",\"tech_stack_signals\":[\"Kubernetes\",\"Datadog\"],\"buyer_titles\":[\"VP Engineering\",\"Head of SRE\"],\"pain_signals\":[\"on-call fatigue\",\"high MTTR\"]}",
      "type": "string"
    },
    {
      "key": "chartFunction",
      "value": "Engineering/Platform",
      "type": "string"
    },
    {
      "key": "commentPostId",
      "value": "",
      "type": "string"
    },
    {
      "key": "generatedComment",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Org Chart Outreach",
      "description": "ICP extraction (Prompt 1: screen + extract ICP) and ICP target-account candidate fetch + ranking (Prompt 2) endpoints.",
      "item": [
        {
          "name": "ICP Extract - Provided Profiles (Gaurav @ Sherlocks.ai)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('ICP Extract (provided profiles): status', pm.response.code);",
                  "",
                  "pm.test('Status is 2xx', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "console.log('ICP Extract response:', JSON.stringify(json, null, 2));",
                  "",
                  "pm.test('sells is a non-empty string', function () {",
                  "    pm.expect(json.sells).to.be.a('string').and.to.have.length.above(0);",
                  "});",
                  "",
                  "pm.test('Founder-led sales at a 10-person startup screens as TRUE', function () {",
                  "    pm.expect(json.relevant_recipient_for_target_account_lure).to.eql(true);",
                  "});",
                  "",
                  "pm.test('reasoning justifies the call', function () {",
                  "    pm.expect(json.reasoning).to.be.a('string').and.to.have.length.above(20);",
                  "});",
                  "",
                  "pm.test('icp has all fields with correct shapes', function () {",
                  "    pm.expect(json.icp.industry).to.be.an('array');",
                  "    pm.expect(json.icp.employee_range).to.be.a('string');",
                  "    pm.expect(json.icp.tech_stack_signals).to.be.an('array');",
                  "    pm.expect(json.icp.buyer_titles).to.be.an('array').and.to.have.length.above(0);",
                  "    pm.expect(json.icp.pain_signals).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('chart_function targets engineering, not sales, for an SRE tool', function () {",
                  "    pm.expect(json.chart_function).to.be.a('string');",
                  "    pm.expect(json.chart_function.toLowerCase()).to.not.include('sales');",
                  "});",
                  "",
                  "pm.test('contextUsed reports provided sources', function () {",
                  "    pm.expect(json.contextUsed.personSource).to.eql('provided');",
                  "    pm.expect(json.contextUsed.companySource).to.eql('provided');",
                  "});",
                  "",
                  "if (json.icp) {",
                  "    pm.collectionVariables.set('extractedIcp', JSON.stringify(json.icp));",
                  "    if (json.chart_function) {",
                  "        pm.collectionVariables.set('chartFunction', json.chart_function);",
                  "    }",
                  "    console.log('Stored extractedIcp + chartFunction collection variables for candidates requests');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/org-chart-outreach/icp/extract",
              "host": ["{{baseUrl}}"],
              "path": ["org-chart-outreach", "icp", "extract"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"personProfile\": {\n    \"object\": \"UserProfile\",\n    \"provider\": \"LINKEDIN\",\n    \"provider_id\": \"ACoAAAHU7vABvj0KTKkaLOIc5El2eMWE5aLnPq4\",\n    \"public_identifier\": \"gaurav-sherlocks-ai\",\n    \"first_name\": \"Gaurav\",\n    \"last_name\": \"Toshniwal\",\n    \"headline\": \"Alerts / Tickets → Root Cause → Fix... in Minutes | Co-founder @Sherlocks.ai | Ex-CTO at Doubtnut (50M+ users)\",\n    \"location\": \"San Francisco, California, United States\",\n    \"follower_count\": 11284,\n    \"connections_count\": 8220,\n    \"work_experience\": [\n      {\n        \"company_id\": \"105905196\",\n        \"company\": \"Sherlocks.ai\",\n        \"position\": \"Founder\",\n        \"location\": \"San Francisco Bay Area, Mumbai · Hybrid\",\n        \"description\": \"We're building AI that thinks like an SRE, works like a beast, and never needs coffee (but you still can). Less firefighting, more winning. If your infra's playing games, we're here to outsmart it. Let's talk AI, ops, and the future of reliability.\",\n        \"status\": \"Full-time\",\n        \"skills\": [\"Site Reliability Engineering\", \"On-call Support\", \"DevOps\"],\n        \"start\": \"1/1/2025\",\n        \"end\": null\n      },\n      {\n        \"company_id\": \"13222185\",\n        \"company\": \"Doubtnut\",\n        \"position\": \"Chief Technology Officer\",\n        \"location\": \"Gurugram, Haryana, India\",\n        \"status\": \"Full-time\",\n        \"skills\": [\"Node.js\", \"Kubernetes\", \"AWS\", \"DevOps\", \"Microservices\"],\n        \"start\": \"11/1/2019\",\n        \"end\": \"1/1/2025\"\n      }\n    ]\n  },\n  \"companyProfile\": {\n    \"object\": \"CompanyProfile\",\n    \"id\": \"105905196\",\n    \"name\": \"Sherlocks.ai\",\n    \"description\": \"Every production incident has a culprit. We built a detective agency to find it. Sherlocks.ai is an agentic AI SRE platform. When an alert fires, our agents don't wait for a human to open six dashboards and start guessing. They investigate immediately: correlate signals across your stack, test hypotheses like a senior engineer would, and deliver root cause with clear next steps. Minutes, not hours. 16+ specialized agents across Kubernetes, databases, networks, cloud infra, CI/CD. 30+ integrations. Read-only access, always. 70% less downtime. 90% less alert noise. SOC 2 Type 2 certified. Data stays in your VPC.\",\n    \"public_identifier\": \"sherlocks-ai\",\n    \"tagline\": \"The best (SRE) Investigators\",\n    \"activities\": [\"SRE\", \"Site Reliability\", \"AI\", \"incident management\", \"AIOps\", \"Observability\", \"Devops\", \"MTTR Reduction\", \"Incident Response\", \"Alert management\", \"Reliability Automation\", \"Agentic AI\", \"ITOps\"],\n    \"website\": \"https://www.sherlocks.ai\",\n    \"foundation_date\": \"01/01/2025\",\n    \"employee_count\": 10,\n    \"industry\": [\"IT System Operations and Maintenance\"],\n    \"locations\": [\n      { \"is_headquarter\": true, \"city\": \"Palo Alto\", \"country\": \"US\", \"area\": \"California\" }\n    ]\n  }\n}"
            },
            "description": "Prompt 1: screens the lead and extracts the ICP from raw Unipile person + company profile JSON. Stores the resulting icp and chart_function in collection variables for the candidates requests."
          }
        },
        {
          "name": "ICP Extract - Person Identifier Only (company derived from current role)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('ICP Extract (person only): status', pm.response.code);",
                  "",
                  "pm.test('Status is 2xx', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "console.log('ICP Extract (person only) response:', JSON.stringify(json, null, 2));",
                  "",
                  "pm.test('person was fetched via Unipile', function () {",
                  "    pm.expect(json.contextUsed.personSource).to.eql('unipile');",
                  "});",
                  "",
                  "pm.test('company was derived from the person\\'s current role', function () {",
                  "    pm.expect(json.contextUsed.companySource).to.eql('derived_from_person');",
                  "    pm.expect(json.contextUsed.derivedCompanyIdentifier).to.eql('105905196');",
                  "});",
                  "",
                  "pm.test('icp fields are present', function () {",
                  "    pm.expect(json.icp.buyer_titles).to.be.an('array').and.to.have.length.above(0);",
                  "    pm.expect(json.icp.employee_range).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/org-chart-outreach/icp/extract",
              "host": ["{{baseUrl}}"],
              "path": ["org-chart-outreach", "icp", "extract"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"personIdentifier\": \"gaurav-sherlocks-ai\",\n  \"includePosts\": false\n}"
            },
            "description": "Only the person identifier is sent. The server fetches the person via the pooled Unipile session, takes the company_id of their current work_experience entry (105905196 = Sherlocks.ai), fetches that company profile, and runs the extraction. Requires Unipile to be configured on the server."
          }
        },
