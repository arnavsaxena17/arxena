        {
          "name": "ICP Generate Message - Connection Request (ICP + last-month post)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('ICP Generate Message: status', pm.response.code);",
                  "",
                  "pm.test('Status is 2xx', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "console.log('ICP Generate Message response:', JSON.stringify(json, null, 2));",
                  "",
                  "pm.test('message is a non-empty string within 300 chars', function () {",
                  "    pm.expect(json.message).to.be.a('string').and.to.have.length.above(0);",
                  "    pm.expect(json.message.length).to.be.at.most(300);",
                  "});",
                  "",
                  "pm.test('contextUsed reports the post window', function () {",
                  "    pm.expect(json.contextUsed.recentPostDays).to.eql(30);",
                  "    pm.expect(json.contextUsed.postsConsidered).to.be.a('number');",
                  "    pm.expect(json.contextUsed.postsWithinWindow).to.be.a('number');",
                  "});",
                  "",
                  "if (json.recentPostUsed) {",
                  "    console.log('Hooked on post from', json.recentPostUsed.parsedDatetime, ':', json.recentPostUsed.text.slice(0, 120));",
                  "    pm.test('hooked post is within the last month', function () {",
                  "        const ageDays = (Date.now() - Date.parse(json.recentPostUsed.parsedDatetime)) / 86400000;",
                  "        pm.expect(ageDays).to.be.at.most(31);",
                  "    });",
                  "} else {",
                  "    console.log('No post within the last month; message hooked on ICP only');",
                  "}"
                ]
              }
            }
          ],
