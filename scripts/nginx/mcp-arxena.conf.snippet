# Arxena MCP — nginx vhost for mcp.arxena.com (direct to EC2, no CloudFront).
# Proxies to the NestJS server (:3000), which serves /mcp, /oauth/* and /.well-known/*.
# Pair with API_ONLY_HOSTS=mcp.arxena.com in the server env so OAuth /authorize goes to the
# default frontend.
# Deploy: sudo cp to /etc/nginx/sites-available/mcp-arxena.conf && ln -s sites-enabled

server {
  listen 80;
  server_name mcp.arxena.com;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name mcp.arxena.com;

  ssl_certificate /etc/letsencrypt/live/mcp.arxena.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/mcp.arxena.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  # Old standalone server pages
  location = /docs/mcp {
    return 301 https://arxena.com/solutions/mcp-server;
  }

  location = /health {
    proxy_pass http://127.0.0.1:3000/healthz;
    proxy_set_header Host $host;
  }

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}
