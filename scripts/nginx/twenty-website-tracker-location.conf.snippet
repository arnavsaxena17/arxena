# Website tracker REST (`WebsiteTrackerController` @Controller('website-tracker')).
# Insert this block in the app / workspace vhost BEFORE `location /`.
#
# `location ^~ /website/` (leads/consent) does NOT match `/website-tracker`
# because of the trailing slash. Without this block, GET serves index.html
# (SPA) and POST/OPTIONS return nginx 405.
#
# Deploy: merge into /etc/nginx/sites-enabled/twenty.conf, then
#   sudo nginx -t && sudo systemctl reload nginx

location ^~ /website-tracker/ {
    access_log /var/log/nginx/api_endpoints_debug.log;
    error_log /var/log/nginx/api_endpoints_error.log warn;

    proxy_pass http://localhost:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
