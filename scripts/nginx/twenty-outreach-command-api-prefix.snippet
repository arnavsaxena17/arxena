# Outreach Command REST (`OutreachCommandController` @Controller('outreach-command'))
# and Outreach Mock REST (`OutreachMockController` @Controller('outreach-mock')).
#
# Production `twenty.conf` proxies API prefixes via a single regex location
# (see `location ~ ^/(client-config|...|warm-paths)(/.*)?$`). Paths NOT in
# that list fall through to the SPA `location /` — GET returns index.html,
# POST returns nginx 405 Not Allowed.
#
# Add both prefixes to the regex (before the closing `)(/.*)?$`):
#   |outreach-command|outreach-mock
#
# Example (fragment):
#   ...|warm-paths|outreach-command|outreach-mock)(/.*)?$ {
#
# Deploy on app.arxena.com:
#   sudo cp /etc/nginx/sites-enabled/twenty.conf /etc/nginx/sites-enabled/twenty.conf.bak-$(date +%Y%m%d%H%M%S)
#   # edit regex, then:
#   sudo nginx -t && sudo systemctl reload nginx
#
# Verify (expect JSON from Nest, not text/html / 405):
#   curl -sI 'https://<workspace>.arxena.com/outreach-command/cache/companies?projectId=test'
#   curl -sI -X POST 'https://<workspace>.arxena.com/outreach-mock/candidates/test/accept'
